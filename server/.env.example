# Port the server listens on (Render sets this automatically — do not set manually)
# PORT=3001

# Public URL of this backend — used by the fake provider to send webhooks back.
# Render injects RENDER_EXTERNAL_URL automatically — no action needed on Render.
# On other platforms, set this to your deployment URL.
# BACKEND_URL=https://your-app.onrender.com

# Shared secret used to sign and verify webhook payloads (HMAC-SHA256).
# Set this to a strong random string — the server will warn at startup if it is missing.
# Example: openssl rand -hex 32
WEBHOOK_SECRET=replace_with_a_strong_random_secret

# Frontend URL — used to restrict CORS and WebSocket connections to your Vercel deployment.
# Set this to your Vercel URL once deployed.
# Example: https://your-app.vercel.app
ALLOWED_ORIGIN=http://localhost:5173

# Optional: override the simulated payment processing delay in milliseconds (default: 4000)
# PAYMENT_PROCESSING_DELAY=4000
