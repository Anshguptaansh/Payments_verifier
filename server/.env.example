# Port the server listens on (Railway sets this automatically)
PORT=3001

# Public URL of this backend — used by the fake provider to send webhooks back.
# On Render, this is set automatically via RENDER_EXTERNAL_URL — no action needed.
# On other platforms, set this manually to your deployment URL.
# BACKEND_URL=https://your-app.onrender.com

# Shared secret used to sign and verify webhook payloads (HMAC-SHA256)
# Change this to a strong random string in production
WEBHOOK_SECRET=super_secret_webhook_key_12345
