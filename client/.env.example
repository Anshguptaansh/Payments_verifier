# Base URL of the backend REST API.
# Set this to your Render deployment URL once the backend is deployed.
# Example: https://your-app.onrender.com
VITE_API_URL=http://localhost:3001

# WebSocket URL of the backend — same host as the API but with wss:// in production.
# Render terminates TLS at the edge, so use wss:// for the public URL.
# Example: wss://your-app.onrender.com
VITE_WS_URL=ws://localhost:3001
