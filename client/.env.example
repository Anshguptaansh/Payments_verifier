# Base URL of the backend REST API — set to your Railway deployment URL in production
# Example: https://payments-verifier-production.up.railway.app
VITE_API_URL=http://localhost:3001

# WebSocket URL of the backend — same host as API but with ws:// (or wss:// in production)
# Example: wss://payments-verifier-production.up.railway.app
VITE_WS_URL=ws://localhost:3001
